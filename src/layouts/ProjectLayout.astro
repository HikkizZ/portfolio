---
// Caso de estudio de un proyecto — estructura exacta de 02_diseno.md §3.2 y
// wireframes §4.3/§4.4. No hay `cover` en ningún proyecto hoy: la figura de
// la sección 4 del diseño se omite (§8.1 "si no hay ni diagrama ni captura:
// no inventar, usar solo la ficha técnica y omitir la figura").
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TechSheet from "../components/ui/TechSheet.astro";
import { useTranslations } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  prev: CollectionEntry<"projects"> | null;
  next: CollectionEntry<"projects"> | null;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const t = useTranslations();

const techSheetLinks: { label: string; href: string }[] = [];
if (data.links.repo) techSheetLinks.push({ label: t.techSheet.repo, href: data.links.repo });
if (data.links.demo) techSheetLinks.push({ label: t.techSheet.demo, href: data.links.demo });
if (data.links.docs) techSheetLinks.push({ label: t.techSheet.docs, href: data.links.docs });
---

<BaseLayout
  title={`${data.title} — Felipe Miranda`}
  description={data.summary}
  canonicalPath={`/proyectos/${project.id}/`}
>
  <article>
    <div class="container-page mt-10">
      <p>
        <a
          href="/#proyectos"
          class="text-mono text-text-muted transition-colors duration-150 ease-out hover:text-accent"
        >
          {t.projectDetail.breadcrumb}
        </a>
      </p>
      <h1 class="mt-4 text-h1 text-text">{data.title}</h1>
      <p class="mt-2 text-mono text-text-muted">{data.year} · {data.kind} · {data.role}</p>
      <p class="prose-width mt-4 text-body text-text-muted">{data.summary}</p>
    </div>

    <div class="container-page mt-10 lg:grid lg:grid-cols-[1fr_320px] lg:items-start lg:gap-12">
      <div class="lg:order-2">
        <h2 id="ficha-tecnica-heading" class="sr-only">{t.techSheet.heading}</h2>
        <TechSheet
          labelledBy="ficha-tecnica-heading"
          stack={data.stack}
          status={data.status}
          metrics={data.metrics}
          links={techSheetLinks}
        />
      </div>

      <div class="project-prose prose-width mt-8 lg:order-1 lg:mt-0">
        <slot />
      </div>
    </div>

    <nav
      aria-label={t.projectDetail.navAriaLabel}
      class="container-page mt-16 flex flex-col gap-4 border-t border-border pt-8 text-mono sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        {
          prev && (
            <a
              href={`/proyectos/${prev.id}/`}
              class="text-text-muted transition-colors duration-150 ease-out hover:text-accent"
            >
              {t.projectDetail.previousLabel} {prev.data.title}
            </a>
          )
        }
      </p>
      <p class="sm:text-right">
        {
          next && (
            <a
              href={`/proyectos/${next.id}/`}
              class="text-text-muted transition-colors duration-150 ease-out hover:text-accent"
            >
              {t.projectDetail.nextLabel} {next.data.title} {t.projectDetail.nextArrow}
            </a>
          )
        }
      </p>
    </nav>
  </article>
</BaseLayout>
