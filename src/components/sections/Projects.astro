---
// Sección 2 "proyectos" — 02_diseno.md §3.1.
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import { useTranslations } from "../../i18n";

const t = useTranslations();
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id="proyectos"
  aria-labelledby="proyectos-heading"
  class="scroll-mt-[72px] border-t border-border py-16 md:py-24"
>
  <div class="container-page">
    <SectionHeading
      number={t.home.projects.number}
      title={t.home.projects.heading}
      id="proyectos-heading"
    />
    <p class="prose-width mt-2 text-body text-text-muted">{t.home.projects.subtitle}</p>

    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        projects.map((project) => (
          <ProjectCard
            href={`/proyectos/${project.id}/`}
            year={project.data.year}
            kind={project.data.kind}
            title={project.data.title}
            summary={project.data.summary}
            stack={project.data.stack}
          />
        ))
      }
    </div>
  </div>
</section>
