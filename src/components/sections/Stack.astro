---
// Sección 4 "stack" — 02_diseno.md §3.1.
import Badge from "../ui/Badge.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { skillGroups } from "../../data/skills";
import { useTranslations } from "../../i18n";

const t = useTranslations();
---

<section
  id="stack"
  aria-labelledby="stack-heading"
  class="scroll-mt-[72px] border-t border-border py-16 md:py-24"
>
  <div class="container-page">
    <SectionHeading number={t.home.stack.number} title={t.home.stack.heading} id="stack-heading" />
    <dl class="mt-6 flex flex-col gap-4">
      {
        skillGroups.map((group) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
            <dt class="text-mono text-text-muted sm:w-40 sm:shrink-0">{group.label}</dt>
            <dd>
              <ul role="list" class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li>
                    <Badge>{item}</Badge>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
