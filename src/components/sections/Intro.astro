---
// Sección 1 "intro" — 02_diseno.md §3.1. Sin numeración (no lleva SectionHeading).
import Button from "../ui/Button.astro";
import Link from "../ui/Link.astro";
import { site } from "../../data/site";
import { useTranslations } from "../../i18n";

const t = useTranslations();
---

<section id="intro" class="py-16 md:py-24">
  <div class="container-page">
    <h1 class="text-display text-text">{site.name}</h1>
    <p class="mt-3 text-mono text-text-muted">{site.roleLine}</p>
    <p class="prose-width mt-6 text-body text-text">{site.intro}</p>

    <div class="mt-8 flex flex-col gap-3 sm:max-w-md sm:flex-row">
      <Button variant="primary" href="#proyectos" fullWidthMobile>
        {t.home.intro.viewProjects}
      </Button>
      <Button variant="secondary" href={site.cvPath} download fullWidthMobile>
        {t.home.intro.downloadCv}
      </Button>
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-body">
      <Link href={site.github} external>{t.footer.github}</Link>
      <span aria-hidden="true" class="text-text-muted">·</span>
      <Link href={site.linkedin} external>{t.footer.linkedin}</Link>
      <span aria-hidden="true" class="text-text-muted">·</span>
      <Link href={`mailto:${site.email}`}>{site.email}</Link>
    </p>
  </div>
</section>
