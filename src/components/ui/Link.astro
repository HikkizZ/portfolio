---
interface Props {
  href: string;
  external?: boolean;
  /** Descarga el recurso en vez de navegar (ej. CV en PDF) — 02_diseno.md §10. */
  download?: boolean;
  class?: string;
}

const { href, external = false, download = false, class: className = "" } = Astro.props;
---

<a
  href={href}
  rel={external ? "noopener noreferrer" : undefined}
  download={download ? true : undefined}
  class={`text-accent underline decoration-1 underline-offset-[3px] transition-colors duration-150 ease-out hover:text-accent-hover hover:decoration-2 ${className}`}
>
  <slot />
</a>
