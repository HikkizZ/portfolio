---
import { useTranslations } from "../../i18n";

const t = useTranslations();
const year = new Date().getFullYear();
const copyright = t.footer.copyright.replace("{year}", String(year));
---

<footer class="border-t border-border py-8">
  <div
    class="container-page flex flex-col gap-4 text-small text-text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{copyright}</p>
    <nav aria-label={t.footer.ariaLabel} class="flex flex-wrap gap-x-4 gap-y-2">
      {/* TODO Fase 2: reemplazar "#" por los links reales de src/data/site.ts */}
      <a
        href="#"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-11 items-center transition-colors duration-150 ease-out hover:text-text"
      >
        {t.footer.github}
      </a>
      <a
        href="#"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-11 items-center transition-colors duration-150 ease-out hover:text-text"
      >
        {t.footer.linkedin}
      </a>
      <a
        href="#"
        class="inline-flex min-h-11 min-w-11 items-center transition-colors duration-150 ease-out hover:text-text"
      >
        {t.footer.email}
      </a>
      <a
        href="#"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-11 items-center transition-colors duration-150 ease-out hover:text-text"
      >
        {t.footer.sourceCode}
      </a>
    </nav>
  </div>
</footer>
