---
import { useTranslations } from "../../i18n";

const t = useTranslations();
---

<button
  type="button"
  id="theme-toggle"
  aria-pressed="false"
  aria-label={t.theme.toggleAriaLabelToDark}
  data-label-dark={t.theme.toggleAriaLabelToDark}
  data-label-light={t.theme.toggleAriaLabelToLight}
  class="inline-flex h-11 w-11 items-center justify-center rounded-full text-text-muted transition-colors duration-150 ease-out hover:bg-surface-2 hover:text-text"
>
  <svg
    data-icon="sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    class="h-5 w-5"
  >
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    />
  </svg>
  <svg
    data-icon="moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    class="hidden h-5 w-5"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
</button>

<script>
  const button = document.getElementById("theme-toggle");
  const sunIcon = button?.querySelector('[data-icon="sun"]');
  const moonIcon = button?.querySelector('[data-icon="moon"]');

  function currentTheme(): "light" | "dark" {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function render(theme: "light" | "dark") {
    if (!button) return;
    const isDark = theme === "dark";
    button.setAttribute("aria-pressed", String(isDark));
    button.setAttribute(
      "aria-label",
      (isDark ? button.dataset.labelLight : button.dataset.labelDark) ?? ""
    );
    sunIcon?.classList.toggle("hidden", isDark);
    moonIcon?.classList.toggle("hidden", !isDark);
  }

  button?.addEventListener("click", () => {
    const next = currentTheme() === "dark" ? "light" : "dark";
    // Revisión de diseño #2, hallazgo #9 / 02_diseno.md §13.6: sin esto,
    // transition-colors (links, botones, badges) hace un fundido de 150ms
    // al cambiar de tema. Se desactivan las transiciones un frame.
    document.documentElement.classList.add("no-transitions");
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    render(next);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.documentElement.classList.remove("no-transitions");
      });
    });
  });

  render(currentTheme());
</script>
