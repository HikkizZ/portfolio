---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Link from "../components/ui/Link.astro";
import Badge from "../components/ui/Badge.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TechSheet from "../components/ui/TechSheet.astro";
import DecisionBlock from "../components/ui/DecisionBlock.astro";
import { useTranslations } from "../i18n";

const t = useTranslations();

const exampleStack = ["TypeScript", "Astro", "Tailwind", "PostgreSQL", "Docker"];

const exampleProject = {
  href: "#",
  year: "2025",
  kind: "Ejemplo",
  title: "Proyecto de ejemplo",
  summary:
    "Resumen de ejemplo para revisar la tarjeta con dos líneas de texto en desktop y line-clamp en móvil.",
  stack: exampleStack,
};

const exampleMetrics = [
  { value: "36", label: "tests de ejemplo" },
  { value: "11", label: "roles de ejemplo" },
];

const exampleLinks = [{ label: "Repositorio (ejemplo)", href: "#" }];
---

<BaseLayout title={`${t.kit.title} — Felipe Miranda`} description={t.kit.description} noindex>
  <div class="container-page flex flex-col gap-16 py-16">
    <section aria-labelledby="kit-heading">
      <h1 id="kit-heading" class="text-display text-text">{t.kit.title}</h1>
      <p class="mt-2 text-small text-text-muted">{t.kit.exampleTag}</p>
    </section>

    <section aria-labelledby="kit-buttons" class="flex flex-col gap-4">
      <SectionHeading number="01" title="Botones" id="kit-buttons" />
      <div class="flex flex-wrap items-center gap-4">
        <Button variant="primary" href="#">Ver proyectos</Button>
        <Button variant="secondary" href="#">Descargar CV (PDF)</Button>
        <Button variant="primary">Botón primario (button)</Button>
        <Button variant="secondary" href="https://example.com" external>Link externo</Button>
      </div>
      <div class="flex flex-col gap-3 sm:max-w-xs">
        <Button variant="primary" href="#" fullWidthMobile>Full-width en móvil</Button>
        <Button variant="secondary" href="#" fullWidthMobile>Full-width en móvil</Button>
      </div>
    </section>

    <section aria-labelledby="kit-links" class="flex flex-col gap-4">
      <SectionHeading number="02" title="Links de texto" id="kit-links" />
      <p class="prose-width text-body text-text">
        Un párrafo con un <Link href="#">link de texto</Link> y otro &#32;
        <Link href="https://example.com" external>link externo</Link>.
      </p>
    </section>

    <section aria-labelledby="kit-badges" class="flex flex-col gap-4">
      <SectionHeading number="03" title="Badges" id="kit-badges" />
      <ul role="list" class="flex flex-wrap gap-2">
        {
          exampleStack.map((tech) => (
            <li>
              <Badge>{tech}</Badge>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="kit-cards" class="flex flex-col gap-4">
      <SectionHeading number="04" title="Tarjeta de proyecto" id="kit-cards" />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <ProjectCard {...exampleProject} />
        <ProjectCard
          {...exampleProject}
          title="Proyecto de ejemplo 2"
          summary="Resumen corto de ejemplo."
        />
      </div>
    </section>

    <section aria-labelledby="kit-techsheet" class="flex flex-col gap-4">
      <SectionHeading number="05" title="Ficha técnica" id="kit-techsheet" />
      <div class="max-w-xs">
        <TechSheet
          labelledBy="kit-techsheet"
          stack={exampleStack}
          status="En producción (ejemplo)"
          metrics={exampleMetrics}
          links={exampleLinks}
        />
      </div>
    </section>

    <section aria-labelledby="kit-decision" class="flex flex-col gap-4">
      <SectionHeading number="06" title="Bloque de decisión técnica" id="kit-decision" />
      <DecisionBlock
        title="Decisión de ejemplo"
        decision="Texto de ejemplo de la decisión tomada."
        why="Texto de ejemplo de la justificación."
        discarded="Texto de ejemplo de la alternativa descartada."
      />
    </section>

    <section aria-labelledby="kit-colors" class="flex flex-col gap-4">
      <SectionHeading number="07" title="Colores" id="kit-colors" />
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-6">
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-bg" />
          <span class="text-mono text-text-muted">--bg</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-surface" />
          <span class="text-mono text-text-muted">--surface</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-surface-2" />
          <span class="text-mono text-text-muted">--surface-2</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-border" />
          <span class="text-mono text-text-muted">--border</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-border-strong" />
          <span class="text-mono text-text-muted">--border-strong</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-text" />
          <span class="text-mono text-text-muted">--text</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-text-muted" />
          <span class="text-mono text-text-muted">--text-muted</span>
        </div>
        <div class="flex flex-col gap-2 rounded-[var(--radius)] border border-border p-3">
          <div class="h-10 rounded-[var(--radius-sm)] border border-border bg-accent" />
          <span class="text-mono text-text-muted">--accent</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
